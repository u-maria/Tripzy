<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/tripzy_background">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:paddingBottom="88dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <!-- Top bar -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="72dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="16dp">

                <TextView
                    android:id="@+id/backButton"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:text="‹"
                    android:textSize="38sp"
                    android:gravity="center"
                    android:textColor="@color/tripzy_text"
                    android:fontFamily="@font/new_spirit_condensed" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="58dp"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:background="@drawable/bg_search_bar"
                    android:elevation="3dp"
                    android:layout_marginStart="8dp"
                    android:layout_marginEnd="8dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Trip to Graz"
                        android:textSize="18sp"
                        android:textColor="@color/tripzy_text"
                        android:fontFamily="@font/helvetica_neue_light"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="15–17 May · 1 guest"
                        android:textSize="14sp"
                        android:textColor="@color/tripzy_text_secondary"
                        android:fontFamily="@font/helvetica_neue_light" />
                </LinearLayout>

                <TextView
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:text="☷"
                    android:textSize="26sp"
                    android:gravity="center"
                    android:textColor="@color/tripzy_text"
                    android:background="@drawable/bg_chip" />
            </LinearLayout>

            <!-- Filter chips -->
            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:scrollbars="none">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView style="@style/TripzyChip" android:text="Train" />
                    <TextView style="@style/TripzyChip" android:text="Eco-friendly" />
                    <TextView style="@style/TripzyChip" android:text="Cheapest first" />
                    <TextView style="@style/TripzyChip" android:text="Weekend trip" />

                </LinearLayout>
            </HorizontalScrollView>

            <!-- Route section -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Best route options"
                android:textSize="26sp"
                android:textStyle="bold"
                android:textColor="@color/tripzy_text"
                android:fontFamily="@font/new_spirit_condensed"
                android:layout_marginTop="30dp"
                android:layout_marginBottom="14dp" />

            <!-- Route card 1 -->
            <LinearLayout
                android:id="@+id/trainRouteCard"
                android:clickable="true"
                android:focusable="true"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_card"
                android:elevation="3dp"
                android:padding="18dp"
                android:layout_marginBottom="14dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:text="🚆"
                        android:textSize="28sp"
                        android:gravity="center"
                        android:background="@drawable/bg_chip" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:layout_marginStart="14dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Vienna → Graz"
                            android:textSize="20sp"
                            android:textStyle="bold"
                            android:textColor="@color/tripzy_text"
                            android:fontFamily="@font/helvetica_neue_light" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Direct train · 2h 35m · Low CO₂"
                            android:textSize="14sp"
                            android:textColor="@color/tripzy_text_secondary"
                            android:fontFamily="@font/helvetica_neue_light"
                            android:layout_marginTop="3dp" />
                    </LinearLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/helvetica_neue_light"
                        android:text="€19"
                        android:textColor="@color/tripzy_text"
                        android:textSize="22sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:text="Recommended eco route"
                    android:textSize="13sp"
                    android:gravity="center"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:textColor="@color/tripzy_text_secondary"
                    android:background="@drawable/bg_chip"
                    android:fontFamily="@font/helvetica_neue_light"
                    android:layout_marginTop="14dp" />
            </LinearLayout>

            <!-- Route card 2 -->
            <LinearLayout
                android:id="@+id/busRouteCard"
                android:clickable="true"
                android:focusable="true"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_card"
                android:elevation="3dp"
                android:padding="18dp"
                android:layout_marginBottom="14dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:text="🚌"
                        android:textSize="28sp"
                        android:gravity="center"
                        android:background="@drawable/bg_chip" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:layout_marginStart="14dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Vienna → Graz"
                            android:textSize="20sp"
                            android:textStyle="bold"
                            android:textColor="@color/tripzy_text"
                            android:fontFamily="@font/helvetica_neue_light" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Bus · 3h 10m · Budget-friendly"
                            android:textSize="14sp"
                            android:textColor="@color/tripzy_text_secondary"
                            android:fontFamily="@font/helvetica_neue_light"
                            android:layout_marginTop="3dp" />
                    </LinearLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="€12"
                        android:textSize="22sp"
                        android:textStyle="bold"
                        android:textColor="@color/tripzy_text"
                        android:fontFamily="@font/helvetica_neue_light" />
                </LinearLayout>
            </LinearLayout>

            <!-- Experiences -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Things to do in Graz"
                android:textSize="26sp"
                android:textStyle="bold"
                android:textColor="@color/tripzy_text"
                android:fontFamily="@font/new_spirit_condensed"
                android:layout_marginTop="18dp"
                android:layout_marginBottom="14dp" />

            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:scrollbars="none">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <!-- Schlossberg Walk -->
                    <LinearLayout style="@style/TripzyTripCard">

                        <ImageView
                            style="@style/TripzyImagePlaceholder"
                            android:src="@drawable/graz_schlossberg"
                            android:scaleType="centerCrop" />

                        <TextView
                            style="@style/TripzyCardTitle"
                            android:text="Schlossberg walk" />

                        <TextView
                            style="@style/TripzyCardSubtitle"
                            android:text="Landmark · 2 hours · free" />
                    </LinearLayout>

                    <!-- Kunsthaus Graz -->
                    <LinearLayout style="@style/TripzyTripCard">

                        <ImageView
                            style="@style/TripzyImagePlaceholder"
                            android:src="@drawable/graz_kunsthaus"
                            android:scaleType="centerCrop" />

                        <TextView
                            style="@style/TripzyCardTitle"
                            android:text="Kunsthaus Graz" />

                        <TextView
                            style="@style/TripzyCardSubtitle"
                            android:text="Museum · from €12" />
                    </LinearLayout>

                    <!-- Mur Riverside Cafés -->
                    <LinearLayout style="@style/TripzyTripCard">

                        <ImageView
                            style="@style/TripzyImagePlaceholder"
                            android:src="@drawable/graz_mur_cafe"
                            android:scaleType="centerCrop" />

                        <TextView
                            style="@style/TripzyCardTitle"
                            android:text="Mur riverside cafés" />

                        <TextView
                            style="@style/TripzyCardSubtitle"
                            android:text="Food &amp; drinks · local favorite" />
                    </LinearLayout>

                </LinearLayout>
            </HorizontalScrollView>

        </LinearLayout>
    </ScrollView>

    <!-- Bottom navigation -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="74dp"
        android:layout_gravity="bottom"
        android:background="@color/tripzy_card"
        android:elevation="8dp"
        android:gravity="center"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/exploreNav"
            style="@style/TripzyNavItem"
            android:text="⌕\nExplore"
            android:textColor="@color/tripzy_primary" />

        <TextView
            android:id="@+id/savedNav"
            style="@style/TripzyNavItem"
            android:text="♡\nSaved" />

        <TextView
            android:id="@+id/tripsNav"
            style="@style/TripzyNavItem"
            android:text="✈\nTrips" />

    </LinearLayout>

</FrameLayout>