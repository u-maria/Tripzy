<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rootLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/tripzy_background">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:paddingBottom="90dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="18dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Hi, User"
                        android:textColor="@color/tripzy_text"
                        android:textSize="32sp"
                        android:textStyle="bold"
                        android:fontFamily="@font/new_spirit_condensed" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:layout_marginBottom="18dp"
                        android:fontFamily="@font/helvetica_neue_light"
                        android:text="Time to plan inspiring trips"
                        android:textColor="@color/tripzy_text_secondary"
                        android:textSize="20sp" />
                </LinearLayout>

                <com.google.android.material.imageview.ShapeableImageView
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:src="@drawable/user_icon"
                    android:scaleType="centerCrop"
                    android:contentDescription="User profile picture"
                    app:shapeAppearanceOverlay="@style/CircleImage"
                    android:background="@drawable/bg_avatar" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="64dp"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <LinearLayout
                    android:id="@+id/searchBar"
                    android:layout_width="0dp"
                    android:layout_height="64dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_search_bar"
                    android:gravity="center_vertical"
                    android:paddingStart="24dp"
                    android:paddingEnd="24dp"
                    android:elevation="4dp"
                    android:clickable="true"
                    android:focusable="true">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="⌕"
                        android:textSize="28sp"
                        android:textColor="@color/tripzy_text"
                        android:layout_marginEnd="12dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/helvetica_neue_light"
                        android:text="Where to next?"
                        android:textColor="@color/tripzy_text_secondary"
                        android:textSize="18sp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/surpriseButton"
                    android:layout_width="64dp"
                    android:layout_height="64dp"
                    android:layout_marginStart="12dp"
                    android:background="@drawable/bg_search_bar"
                    android:clickable="true"
                    android:elevation="4dp"
                    android:focusable="true"
                    android:gravity="center"
                    android:text="🎲"
                    android:textSize="24sp" />
            </LinearLayout>

            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:scrollbars="none">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView style="@style/TripzyChip" android:text="Weekend"
                        android:fontFamily="@font/helvetica_neue_light"/>
                    <TextView style="@style/TripzyChip" android:text="Culture"
                        android:fontFamily="@font/helvetica_neue_light"/>
                    <TextView style="@style/TripzyChip" android:text="Food"
                        android:fontFamily="@font/helvetica_neue_light"/>
                    <TextView style="@style/TripzyChip" android:text="Eco-friendly"
                        android:fontFamily="@font/helvetica_neue_light"/>

                </LinearLayout>
            </HorizontalScrollView>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Popular trips from Vienna"
                android:textSize="24sp"
                android:textStyle="bold"
                android:textColor="@color/tripzy_text"
                android:layout_marginTop="28dp"
                android:layout_marginBottom="14dp"
                android:fontFamily="@font/new_spirit_condensed" />

            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:scrollbars="none">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <LinearLayout style="@style/TripzyTripCard">
                        <ImageView
                            style="@style/TripzyImagePlaceholder"
                            android:src="@drawable/prague"
                            android:scaleType="centerCrop"
                            android:clipToOutline="true" />
                        <TextView style="@style/TripzyCardTitle" android:text="Prague weekend" />

                        <TextView
                            style="@style/TripzyCardSubtitle"
                            android:fontFamily="@font/helvetica_neue_light"
                            android:text="Train • from €29 • 4h 10m" />

                        <TextView
                            style="@style/TripzyEcoLabel"
                            android:fontFamily="@font/helvetica_neue_light"
                            android:text="Eco-friendly option" />
                    </LinearLayout>

                    <LinearLayout style="@style/TripzyTripCard">
                        <ImageView
                            style="@style/TripzyImagePlaceholder"
                            android:src="@drawable/budapest"
                            android:scaleType="centerCrop"
                            android:clipToOutline="true" />
                        <TextView style="@style/TripzyCardTitle" android:text="Budapest by train" />

                        <TextView
                            style="@style/TripzyCardSubtitle"
                            android:fontFamily="@font/helvetica_neue_light"
                            android:text="Train • from €24 • 2h 40m" />

                        <TextView
                            style="@style/TripzyEcoLabel"
                            android:fontFamily="@font/helvetica_neue_light"
                            android:text="Low CO₂ route" />
                    </LinearLayout>

                    <LinearLayout style="@style/TripzyTripCard">
                        <ImageView
                            style="@style/TripzyImagePlaceholder"
                            android:src="@drawable/salzburg"
                            android:scaleType="centerCrop"
                            android:clipToOutline="true" />
                        <TextView style="@style/TripzyCardTitle" android:text="Salzburg escape" />

                        <TextView
                            style="@style/TripzyCardSubtitle"
                            android:fontFamily="@font/helvetica_neue_light"
                            android:text="Train • from €19 • 2h 30m" />

                        <TextView
                            style="@style/TripzyEcoLabel"
                            android:fontFamily="@font/helvetica_neue_light"
                            android:text="No flight needed" />
                    </LinearLayout>

                </LinearLayout>
            </HorizontalScrollView>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Smart deals for your next trip"
                android:textSize="24sp"
                android:textStyle="bold"
                android:textColor="@color/tripzy_text"
                android:layout_marginTop="30dp"
                android:layout_marginBottom="14dp"
                android:fontFamily="@font/new_spirit_condensed" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="86dp"
                    android:background="@drawable/bg_card"
                    android:elevation="3dp"
                    android:gravity="center_vertical"
                    android:padding="16dp"
                    android:layout_marginBottom="12dp">

                    <TextView
                        android:layout_width="46dp"
                        android:layout_height="46dp"
                        android:text="🚆"
                        android:textSize="28sp"
                        android:gravity="center"
                        android:background="@drawable/bg_chip" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:layout_marginStart="14dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Vienna → Prague"
                            android:textSize="17sp"
                            android:textStyle="bold"
                            android:textColor="@color/tripzy_text"
                            android:fontFamily="@font/helvetica_neue_light" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Train • 4h 10m • Low CO₂"
                            android:textSize="13sp"
                            android:textColor="@color/tripzy_text_secondary"
                            android:layout_marginTop="3dp" />
                    </LinearLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="from €29"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:textColor="@color/tripzy_text"
                        android:fontFamily="@font/helvetica_neue_light" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="86dp"
                    android:background="@drawable/bg_card"
                    android:elevation="3dp"
                    android:gravity="center_vertical"
                    android:padding="16dp"
                    android:layout_marginBottom="12dp">

                    <TextView
                        android:layout_width="46dp"
                        android:layout_height="46dp"
                        android:text="🚌"
                        android:textSize="28sp"
                        android:gravity="center"
                        android:background="@drawable/bg_chip" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:layout_marginStart="14dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Vienna → Budapest"
                            android:textSize="17sp"
                            android:textStyle="bold"
                            android:textColor="@color/tripzy_text"
                            android:fontFamily="@font/helvetica_neue_light"
                            />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Bus • 3h • Budget-friendly"
                            android:textSize="13sp"
                            android:textColor="@color/tripzy_text_secondary"
                            android:layout_marginTop="3dp" />
                    </LinearLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="from €18"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:textColor="@color/tripzy_text"
                        android:fontFamily="@font/helvetica_neue_light" />
                </LinearLayout>

            </LinearLayout>

        </LinearLayout>
    </ScrollView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="74dp"
        android:layout_gravity="bottom"
        android:background="@color/tripzy_card"
        android:elevation="8dp"
        android:gravity="center"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/exploreNav"
            style="@style/TripzyNavItem"
            android:text="⌕\nExplore"
            android:textColor="@color/tripzy_text"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/savedNav"
            style="@style/TripzyNavItem"
            android:text="♡\nSaved"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/tripsNav"
            style="@style/TripzyNavItem"
            android:text="✈\nTrips"
            android:textSize="16sp" />

    </LinearLayout>

    <View
        android:id="@+id/overlayBackdrop"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/tripzy_overlay"
        android:visibility="gone" />

    <ScrollView
        android:id="@+id/searchOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone"
        android:padding="20dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingTop="44dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="end">

                <TextView
                    android:id="@+id/closeOverlay"
                    android:layout_width="54dp"
                    android:layout_height="54dp"
                    android:text="×"
                    android:textSize="36sp"
                    android:gravity="center"
                    android:textColor="@color/tripzy_text"
                    android:background="@drawable/bg_card"
                    android:elevation="4dp"
                    android:clickable="true"
                    android:focusable="true" />

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_card"
                android:elevation="8dp"
                android:padding="24dp"
                android:layout_marginTop="18dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Where?"
                    android:textSize="30sp"
                    android:textStyle="bold"
                    android:textColor="@color/tripzy_text" />

                <EditText
                    android:layout_width="match_parent"
                    android:layout_height="58dp"
                    android:hint="Search destination"
                    android:text="Prague, Czechia"
                    android:textSize="17sp"
                    android:singleLine="true"
                    android:background="@drawable/bg_chip"
                    android:paddingStart="18dp"
                    android:paddingEnd="18dp"
                    android:layout_marginTop="16dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="When?"
                    android:textSize="26sp"
                    android:textStyle="bold"
                    android:textColor="@color/tripzy_text"
                    android:layout_marginTop="26dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="14dp">

                    <TextView style="@style/TripzyDateChip" android:text="Today\n9 May" />
                    <TextView style="@style/TripzyDateChip" android:text="Tomorrow\n10 May" />
                    <TextView style="@style/TripzyDateChip" android:text="Weekend\n9–10 May" />

                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="How do you want to travel?"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    android:textColor="@color/tripzy_text"
                    android:layout_marginTop="26dp" />

                <HorizontalScrollView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:scrollbars="none"
                    android:layout_marginTop="12dp">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <TextView style="@style/TripzyChip" android:text="Train" />
                        <TextView style="@style/TripzyChip" android:text="Bus" />
                        <TextView style="@style/TripzyChip" android:text="Flight" />
                        <TextView style="@style/TripzyChip" android:text="Mixed" />

                    </LinearLayout>
                </HorizontalScrollView>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Trip priorities"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    android:textColor="@color/tripzy_text"
                    android:layout_marginTop="24dp" />

                <HorizontalScrollView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:scrollbars="none"
                    android:layout_marginTop="12dp">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <TextView style="@style/TripzyChip" android:text="Cheapest" />
                        <TextView style="@style/TripzyChip" android:text="Fastest" />
                        <TextView style="@style/TripzyChip" android:text="Most eco-friendly" />

                    </LinearLayout>
                </HorizontalScrollView>

                <CheckBox
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Show eco-friendly options only"
                    android:textSize="17sp"
                    android:textColor="@color/tripzy_text"
                    android:layout_marginTop="20dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Who?"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    android:textColor="@color/tripzy_text"
                    android:layout_marginTop="18dp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="54dp"
                    android:text="Adults                                      −   1   +"
                    android:textSize="17sp"
                    android:gravity="center_vertical"
                    android:textColor="@color/tripzy_text"
                    android:layout_marginTop="8dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="64dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginTop="18dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:text="Reset"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:gravity="center_vertical"
                        android:textColor="@color/tripzy_text" />

                    <TextView
                        android:id="@+id/searchButton"
                        android:layout_width="150dp"
                        android:layout_height="56dp"
                        android:text="⌕ Search"
                        android:textSize="20sp"
                        android:textStyle="bold"
                        android:gravity="center"
                        android:textColor="@android:color/white"
                        android:background="@drawable/bg_primary_button" />

                </LinearLayout>

            </LinearLayout>
        </LinearLayout>
    </ScrollView>

</FrameLayout>