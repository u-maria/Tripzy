<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/tripzy_background">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <!-- Header with back button -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="18dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/profileBackButton"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:gravity="center"
                    android:text="‹"
                    android:textSize="40sp"
                    android:textColor="@color/tripzy_text"
                    android:background="@drawable/bg_card"
                    android:elevation="4dp"
                    android:fontFamily="@font/new_spirit_condensed" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="Profile"
                    android:textSize="30sp"
                    android:textStyle="bold"
                    android:textColor="@color/tripzy_text"
                    android:fontFamily="@font/new_spirit_condensed" />

                <View
                    android:layout_width="48dp"
                    android:layout_height="48dp" />
            </LinearLayout>

            <!-- Profile card -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="26dp"
                android:orientation="vertical"
                android:gravity="center_horizontal"
                android:padding="24dp"
                android:background="@drawable/bg_card"
                android:elevation="4dp">

                <com.google.android.material.imageview.ShapeableImageView
                    android:layout_width="86dp"
                    android:layout_height="86dp"
                    android:src="@drawable/user_icon"
                    android:scaleType="centerCrop"
                    app:shapeAppearanceOverlay="@style/CircleImage" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:text="Max Mustermann"
                    android:textSize="30sp"
                    android:textStyle="bold"
                    android:textColor="@color/tripzy_text"
                    android:fontFamily="@font/new_spirit_condensed" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Vienna, Austria"
                    android:textSize="16sp"
                    android:textColor="@color/tripzy_text_secondary"
                    android:fontFamily="@font/helvetica_neue_light" />
            </LinearLayout>


            <!-- Travel preferences -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="30dp"
                android:layout_marginBottom="12dp"
                android:text="Travel preferences"
                android:textSize="26sp"
                android:textStyle="bold"
                android:textColor="@color/tripzy_text"
                android:fontFamily="@font/new_spirit_condensed" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="18dp"
                android:background="@drawable/bg_card"
                android:elevation="3dp">

                <!-- Home city -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Home city"
                    android:textSize="14sp"
                    android:textColor="@color/tripzy_text_secondary"
                    android:fontFamily="@font/helvetica_neue_light" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Vienna"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:textColor="@color/tripzy_text"
                    android:fontFamily="@font/new_spirit_condensed" />

                <!-- Divider -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="16dp"
                    android:layout_marginBottom="16dp"
                    android:background="@color/tripzy_chip" />

                <!-- Preferred transport -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Preferred transport"
                    android:textSize="14sp"
                    android:textColor="@color/tripzy_text_secondary"
                    android:fontFamily="@font/helvetica_neue_light" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Train and bus"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:textColor="@color/tripzy_text"
                    android:fontFamily="@font/new_spirit_condensed" />

                <!-- Divider -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="16dp"
                    android:layout_marginBottom="16dp"
                    android:background="@color/tripzy_chip" />

                <!-- Travel style -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Travel style"
                    android:textSize="14sp"
                    android:textColor="@color/tripzy_text_secondary"
                    android:fontFamily="@font/helvetica_neue_light" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Budget and boutique"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:textColor="@color/tripzy_text"
                    android:fontFamily="@font/new_spirit_condensed" />

                <!-- Divider -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="16dp"
                    android:layout_marginBottom="16dp"
                    android:background="@color/tripzy_chip" />

                <!-- Sustainability -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Sustainability"
                    android:textSize="14sp"
                    android:textColor="@color/tripzy_text_secondary"
                    android:fontFamily="@font/helvetica_neue_light" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Prioritize eco-friendly options"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:textColor="@color/tripzy_text"
                    android:fontFamily="@font/new_spirit_condensed" />
            </LinearLayout>

            <!-- Settings preview -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="30dp"
                android:layout_marginBottom="12dp"
                android:text="Settings"
                android:textSize="26sp"
                android:textStyle="bold"
                android:textColor="@color/tripzy_text"
                android:fontFamily="@font/new_spirit_condensed" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="18dp"
                android:background="@drawable/bg_card"
                android:elevation="3dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:gravity="center_vertical"
                    android:text="Price alerts: On"
                    android:textSize="16sp"
                    android:textColor="@color/tripzy_text"
                    android:fontFamily="@font/helvetica_neue_light" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:gravity="center_vertical"
                    android:text="Currency: EUR"
                    android:textSize="16sp"
                    android:textColor="@color/tripzy_text"
                    android:fontFamily="@font/helvetica_neue_light" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:gravity="center_vertical"
                    android:text="Language: English"
                    android:textSize="16sp"
                    android:textColor="@color/tripzy_text"
                    android:fontFamily="@font/helvetica_neue_light" />

                <!-- SIGN OUT BUTTON -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:layout_marginTop="32dp"
                    android:layout_marginBottom="40dp"
                    android:gravity="center"
                    android:text="Sign out"
                    android:textSize="17sp"
                    android:textColor="@color/tripzy_text"
                    android:background="@drawable/bg_chip"
                    android:fontFamily="@font/helvetica_neue_light" />
            </LinearLayout>

        </LinearLayout>
    </ScrollView>

</FrameLayout>